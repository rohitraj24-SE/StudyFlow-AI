# Local dev port (ignored on Vercel)
PORT=5000

# MongoDB connection string.
# Local dev: mongodb://localhost:27017/smart_study_planner
# Production (Vercel): use a MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_study_planner?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/smart_study_planner

# Any long random string - used to sign JWTs
JWT_SECRET=change_this_to_a_long_random_string

NODE_ENV=development

# ===== REAL LLM AI COACH (optional) =====
# Without these, the AI Coach and doubt-clear chatbot automatically fall
# back to the original free, rule-based engines - nothing breaks if you
# leave them blank. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== BACKGROUND PUSH NOTIFICATIONS (optional) =====
# Without these, notifications fall back to the original tab-open-only
# browser Notification API. Generate a key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret that protects GET /api/cron/daily-digest from being called
# by anyone but Vercel Cron (or you, manually). Any long random string.
CRON_SECRET=
